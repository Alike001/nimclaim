APP_ORIGIN=http://localhost:5173
NETWORK=testnet
DATABASE_PATH=./data/nimclaim.sqlite
PORT=3001
HOST=127.0.0.1
# Never enable spending for the current SDK; selected-sender assurance is unavailable.
SPENDING_ENABLED=false
# Deliberately unset in the safe default: SPENDING_NETWORK, MAX_PAYMENT_LUNA, RPC_URL
PAYMENT_FEE_LUNA=0
# RPC_AUTHORIZATION belongs only in the server environment, never in client code or URLs.
# Optional MAINNET read-only verification of NIM transfers already sent in Nimiq Pay.
# Comma-separated trusted HTTPS RPC origins; this never enables wallet broadcasting.
# NIMIQ_READONLY_RPC_URLS=https://rpc.nimiqwatch.com
